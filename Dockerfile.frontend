ARG APP_NAME=customer-web
FROM node:20-alpine AS builder
ARG APP_NAME
WORKDIR /workspace
COPY scripts/patch-brace-expansion-cjs.cjs scripts/patch-brace-expansion-cjs.cjs
COPY frontend/${APP_NAME}/package*.json frontend/${APP_NAME}/
WORKDIR /workspace/frontend/${APP_NAME}
RUN npm ci
COPY frontend/shared-design-system /workspace/frontend/shared-design-system
COPY frontend/${APP_NAME} ./
ARG VITE_API_BASE_URL=/api
ARG VITE_API_URL=/api
ARG VITE_WS_URL=/socket.io
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL \
    VITE_API_URL=$VITE_API_URL \
    VITE_WS_URL=$VITE_WS_URL
RUN npm run build

FROM nginx:alpine AS production
ARG APP_NAME
RUN apk add --no-cache curl
COPY --from=builder /workspace/frontend/${APP_NAME}/dist /usr/share/nginx/html
COPY nginx/frontend.production.conf /etc/nginx/conf.d/default.conf
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -fsS http://localhost:80/ > /dev/null || exit 1
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
